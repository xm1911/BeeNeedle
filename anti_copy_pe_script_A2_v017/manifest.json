{
  "manifest_version": 3,
  "name": "ビーニードルシステムA2",
  "version": "0.17",
  "description": "まもなく登場",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://tsumanne.net/*",
    "https://c3.ftbucket.info/*",
    "https://may3.ftbucket.info/*",
    "https://may2.ftbucket.info/*",
    "https://futafuta.site/*",
    "https://kako.futakuro.com/*",
    "https://img.2chan.net/*",
    "https://may.2chan.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [{
      "matches": [
        "https://tsumanne.net/*",
        "https://c3.ftbucket.info/*",
        "https://may3.ftbucket.info/*",
        "https://may2.ftbucket.info/*",
        "https://futafuta.site/*",
        "https://kako.futakuro.com/*",
        "https://img.2chan.net/*",
        "https://may.2chan.net/*"
      ],
    "js": ["content-script.js"]
  }]
}